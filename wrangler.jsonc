/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apa-platform",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// ── Workers AI binding ──────────────────────────────────────────────────
	// Exposes this.env.AI in both the Worker and Durable Object.
	"ai": {
		"binding": "AI"
	},

	// ── Phase 4a: D1 Database ───────────────────────────────────────────────
	// 1. Create the database:   npx wrangler d1 create apa-db
	// 2. Copy the database_id from the output and paste it below.
	// 3. Run migrations:        npm run db:migrate:remote
	// 4. (Optional) Seed data:  npm run db:seed:local
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apa-db",
			"database_id": "fa52197c-1a66-4deb-b2e0-5bddd234a351",
			"migrations_dir": "migrations"
		}
	],

	// ── Durable Objects ─────────────────────────────────────────────────────
	"durable_objects": {
		"bindings": [
			{
				"name": "EXAM_SESSION",
				"class_name": "ExamSessionDO"
			},
			{
				"name": "EXAM_HUB",
				"class_name": "ExamHubDO"
			}
		]
	},

	// ── Migrations ──────────────────────────────────────────────────────────
	// v1: initial ExamSessionDO
	// v2: adds ExamHubDO (Phase 3a professor live monitor)
	// v3: no new DO classes; Phase 3b adds intervention storage in existing DOs
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ExamSessionDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ExamHubDO"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": []
		}
	],

	// ── Phase 4c-2a & 4c-2b: Cron Triggers (Auto-end every minute, retention daily at 3am) ─
	"triggers": {
		"crons": ["* * * * *", "0 3 * * *"]
	}
}