/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apa-platform",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// ── Workers AI binding ──────────────────────────────────────────────────
	// Exposes this.env.AI in both the Worker and Durable Object.
	"ai": {
		"binding": "AI"
	},

	// ── Durable Objects ─────────────────────────────────────────────────────
	// One class handles all exam sessions; each session gets its own DO instance.
	"durable_objects": {
		"bindings": [
			{
				"name": "EXAM_SESSION",
				"class_name": "ExamSessionDO"
			}
		]
	},

	// ── Migrations ──────────────────────────────────────────────────────────
	// Required the first time a Durable Object class is deployed.
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["ExamSessionDO"]
		}
	]
}